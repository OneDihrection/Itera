    "shoulderFlexion.overview" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Let your arm hang at your side, then slowly raise it forward with your palm turned up and the arm rotated outward. First show how high you can comfortably lift; that becomes your target. Tuntun tracks how high your wrist rises and pauses scoring when your trunk leans or turns."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Biarkan lengan menggantung di sisi badan, lalu angkat perlahan ke depan dengan telapak tangan menghadap atas dan lengan diputar keluar. Pertama tunjukkan setinggi apa Anda nyaman mengangkat; itu menjadi target Anda. Tuntun melacak setinggi apa pergelangan tangan naik dan menjeda penilaian saat badan Anda condong atau berputar."
          }
        }
      }
    },
    "shoulderFlexion.repetitions" : {
      "extractionState" : "stale",
