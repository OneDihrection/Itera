    "session.assistance.armRaise" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Turn toward the camera. Keep your shoulder and hip in view. Raise your arm only as far as comfortable, then lower it."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hadap ke kamera. Pastikan bahu dan pinggul terlihat. Angkat lengan sejauh yang nyaman, lalu turunkan."
          }
        }
      }
    },
    "session.assistance.cup" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use one empty cup. Keep it in view and follow the guided movements without drinking. Stop if you feel discomfort."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gunakan satu cangkir kosong. Pastikan cangkir terlihat dan ikuti gerakan tanpa minum. Berhenti jika terasa tidak nyaman."
          }
        }
      }
    },
    "session.assistance.elbowBend" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Turn the trained side toward the camera. Keep your shoulder, elbow, and wrist in view. Bend and straighten comfortably."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hadapkan sisi yang dilatih ke kamera. Pastikan bahu, siku, dan pergelangan tangan terlihat. Tekuk dan luruskan dengan nyaman."
          }
        }
      }
    },
    "session.assistance.reach" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keep your face, both shoulders, and the trained arm in view. Reach only as far as comfortable, then return to the start between directions."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pastikan wajah, kedua bahu, dan lengan yang dilatih terlihat. Jangkau sejauh yang nyaman, lalu kembali ke posisi awal di antara arah."
          }
        }
      }
    },
