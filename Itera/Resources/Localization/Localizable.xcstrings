    "plan.purpose.armRaise" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Helps the shoulder lift the arm higher, such as when reaching a shelf or combing hair."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Membantu bahu mengangkat lengan lebih tinggi, seperti saat meraih rak atau menyisir rambut."
          }
        }
      }
    },
    "plan.purpose.crossMidline" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trains the shoulder and arm to move across the body more easily, such as when fastening a seat belt."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Melatih bahu dan lengan agar lebih mudah bergerak menyilang tubuh, seperti saat memasang sabuk pengaman."
          }
        }
      }
    },
    "plan.purpose.directionalReach" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trains reaching in different directions, such as when taking things from a table or shelf."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Melatih meraih ke berbagai arah, seperti saat mengambil barang di meja atau rak."
          }
        }
      }
    },
    "plan.purpose.elbowBend" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trains bending and straightening the elbow, such as when bringing food to the mouth."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Melatih menekuk dan meluruskan siku, seperti saat menyuap makanan ke mulut."
          }
        }
      }
    },
    "plan.purpose.extensionSequence" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trains straightening each finger on its own, for pressing buttons or typing."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Melatih jari untuk bergerak secara terpisah, seperti saat menekan tombol."
          }
        }
      }
    },
    "plan.purpose.externalRotation" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trains turning the shoulder outward, so reaching to the side is easier, such as when opening a door."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Melatih bahu berputar ke luar, supaya lebih mudah membuka lengan ke samping saat berpakaian."
          }
        }
      }
    },
    "plan.purpose.foldTowel" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trains the hand and arm to work together, such as when folding clothes."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Melatih tangan dan lengan bekerja sama, seperti saat melipat pakaian."
          }
        }
      }
    },
    "plan.purpose.forearmRotation" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trains turning the forearm, such as when turning a door knob or pouring water."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Melatih memutar lengan bawah, seperti saat memutar gagang pintu atau menuang air."
          }
        }
      }
    },
    "plan.purpose.fullFist" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Builds grip strength for holding things firmly, such as a cup or a bag handle."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Melatih tangan untuk menggenggam dan melepaskan benda, seperti memegang gelas atau botol."
          }
        }
      }
    },
    "plan.purpose.hookFist" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trains the finger joints to bend separately, for carrying a bag or holding a handle."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Melatih jari untuk memegang benda dengan posisi kait, seperti saat menenteng kantong belanja."
          }
        }
      }
    },
    "plan.purpose.internalRotation" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trains turning the shoulder inward, such as when tucking in a shirt or reaching behind the back."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Melatih bahu berputar ke dalam, supaya lebih mudah saat merapikan pakaian atau memasukkan tangan ke saku."
          }
        }
      }
    },
    "plan.purpose.opposition" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trains the thumb to meet each finger, for picking up small things like a button or a coin."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Melatih jari tangan menjepit benda kecil, seperti mengancingkan baju atau memegang sendok"
          }
        }
      }
    },
    "plan.purpose.shoulderFlexion" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
