    "session.assistance.sitToStand" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sit sideways to the camera with your whole body in view, head to feet. Move at your own pace: lean forward a little, stand up, then sit back down without dropping. Use Recalibrate if you moved the chair or camera."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Duduk menyamping ke kamera dengan seluruh tubuh terlihat, dari kepala sampai kaki. Bergeraklah sesuai kemampuan: condong sedikit ke depan, berdiri, lalu duduk kembali tanpa menjatuhkan diri. Gunakan Kalibrasi ulang jika kursi atau kamera bergeser."
          }
        }
      }
    },
