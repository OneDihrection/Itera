    "cup.guidance" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keep holding one empty cup. Rehearse near your face, return your hand, move the cup sideways, then return the cup. Hold until the circle fills. This rehearsal is not counted."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tetap pegang satu cangkir kosong. Coba dekatkan ke wajah, kembalikan tangan, pindahkan cangkir ke samping, lalu kembalikan cangkir. Tahan sampai lingkaran terisi. Coba gerakan ini belum dihitung."
          }
        }
      }
    },
