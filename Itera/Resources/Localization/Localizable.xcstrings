      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arm raises and elbow bends: five repetitions on each side. Directional reaching: one round on the left. Rest for 15 seconds between activities."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Angkat lengan dan tekuk siku: lima pengulangan tiap sisi. Menjangkau: satu putaran sisi kiri. Istirahat 15 detik antaraktivitas."
          }
        }
      }
    },
