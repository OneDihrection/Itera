    "report.measurementNote" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Percentage compares the best stable movement against this session’s starting range. This is a 2D camera estimate, not grip force, a clinical joint angle, or proof of recovery. Small changes are not displayed. Fingers must be clearly visible; partial movements are not counted."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Persentase membandingkan gerak stabil terbaik dengan jangkauan awal sesi ini. Ini perkiraan kamera 2D, bukan kekuatan genggaman, sudut sendi klinis, atau bukti pemulihan. Perubahan kecil belum ditampilkan. Jari harus terlihat jelas; gerakan sebagian tidak dihitung."
          }
        }
      }
    },
