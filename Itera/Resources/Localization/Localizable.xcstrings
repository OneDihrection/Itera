    "steps.extensionSequence.2" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Straighten the finger shown."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Luruskan jari yang diminta."
          }
        }
