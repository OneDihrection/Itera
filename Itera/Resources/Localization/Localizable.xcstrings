        }
      }
    },
    "steps.forearmRotation.1" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Face your palm toward the camera with your elbow against your body."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hadapkan telapak tangan ke kamera dengan siku menempel pada tubuh."
          }
        }
      }
    },
    "steps.forearmRotation.2" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slowly rotate your forearm 180 degrees."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Putar lengan bawah sebesar 180 derajat secara perlahan."
          }
        }
      }
    },
    "steps.forearmRotation.3" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hold the position until the back of your hand faces the camera."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tahan posisi hingga punggung tangan menghadap kamera."
          }
        }
      }
    },
    "steps.forearmRotation.4" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rotate your forearm back 180 degrees until your palm faces the camera."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Putar kembali lengan bawah sebesar 180 derajat hingga telapak tangan menghadap kamera."
          }
        }
      }
    },
