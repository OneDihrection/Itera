    "routine.cupDetail" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use one empty cup. Keep holding it without drinking. Rehearse near your face, return, move sideways, and return. The rehearsal is not counted."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gunakan satu cangkir kosong. Tetap pegang tanpa minum. Coba dekatkan ke wajah, kembali, ke samping, lalu kembali. Coba gerakan belum dihitung."
          }
        }
      }
    },
