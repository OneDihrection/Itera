      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sit sideways to the camera on a stable chair, about 2 to 3 meters away, so your whole body from head to feet is visible from the side. A side view lets the camera follow your shoulder, hip, knee, and ankle accurately."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Duduk menyamping ke kamera di kursi yang stabil, sekitar 2 sampai 3 meter dari kamera, agar seluruh tubuh dari kepala sampai kaki terlihat dari samping. Tampak samping membuat kamera dapat mengikuti bahu, pinggul, lutut, dan pergelangan kaki dengan akurat."
          }
        }
      }
