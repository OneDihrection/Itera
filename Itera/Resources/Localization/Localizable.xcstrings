    "settings.recordingVideoHelp" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Also keeps a short, low-resolution video of the first, hardest and last repetition of each set. Faces are pixelated and the room is blurred on this iPad before anything is saved. Hand exercises see no body, so only faces the camera recognizes are pixelated there."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Juga menyimpan video singkat beresolusi rendah dari repetisi pertama, tersulit, dan terakhir setiap set. Wajah disamarkan dan ruangan dikaburkan di iPad ini sebelum disimpan. Latihan tangan tidak melihat tubuh, jadi hanya wajah yang dikenali kamera yang disamarkan."
          }
        }
      }
    },
