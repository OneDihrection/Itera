    "therapy.overview.description" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arm raises and elbow bends: five repetitions on each side. Directional reaching: one round on the left. Rest for 15 seconds between activities."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Angkat lengan dan tekuk siku: lima pengulangan tiap sisi. Menjangkau: satu putaran sisi kiri. Istirahat 15 detik antaraktivitas."
          }
        }
      }
    },
    "therapy.overview.positioning" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Place the iPad securely so your face, shoulders, hips, elbows, and wrists remain visible. Move only within a comfortable range."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Letakkan iPad dengan aman agar wajah, bahu, pinggul, siku, dan pergelangan tangan terlihat. Bergeraklah dalam rentang yang nyaman."
          }
        }
      }
    },
