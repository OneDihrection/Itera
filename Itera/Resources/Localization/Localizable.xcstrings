    "routine.sitToStandDetail" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sit sideways to the camera with your whole body in view. No precise pose is needed: you do one sit-to-stand your own way, and your repetitions follow how far you lean and rise. A repetition counts when you lean a little, stand, and sit back down without dropping."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Duduk menyamping ke kamera dengan seluruh tubuh terlihat. Tidak perlu pose yang presisi: Anda melakukan satu kali duduk ke berdiri dengan cara sendiri, dan repetisi mengikuti seberapa jauh Anda condong dan bangkit. Repetisi terhitung bila Anda condong sedikit, berdiri, dan duduk kembali tanpa menjatuhkan diri."
          }
        }
      }
    },
