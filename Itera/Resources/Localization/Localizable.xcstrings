    "routine.phases" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blue: watch the guide. Yellow: capture your range. Green: practice. Gray: rest or pause."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Biru: perhatikan panduan. Kuning: ukur jangkauan. Hijau: latihan. Abu-abu: istirahat atau jeda."
          }
        }
      }
    },
    "routine.reachDetail" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Without objects, reach right, left, and up as far as comfortable. Check your range and rehearse before practice."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tanpa benda, jangkau kanan, kiri, dan atas sejauh yang nyaman. Cek jangkauan dan coba gerakan sebelum latihan."
