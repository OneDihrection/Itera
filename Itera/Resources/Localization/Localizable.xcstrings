    "rotation.overview" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keep your elbow at your side, bent about 90°, and slowly turn your forearm outward. First show how far you can comfortably turn; that becomes your target. Tuntun pauses scoring when your elbow lifts away or your trunk leans or turns."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jaga siku tetap menempel di sisi badan, tertekuk sekitar 90°, lalu putar lengan bawah ke luar secara perlahan. Tunjukkan dulu seberapa jauh Anda nyaman berputar; itu menjadi target Anda. Tuntun menghentikan penilaian bila siku menjauh atau badan miring atau berputar."
          }
        }
      }
    },
