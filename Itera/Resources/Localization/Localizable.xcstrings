    "range.instruction" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slowly turn your forearm back and forth as far as is comfortable. Pause briefly at each end."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Putar lengan bawah Anda perlahan bolak-balik sejauh yang nyaman. Berhenti sebentar di tiap ujung."
          }
        }
      }
    },
    "range.ready" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hold your hand still in the start position. A 3-second countdown begins, then you turn as far as is comfortable."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tahan tangan Anda di posisi awal. Hitung mundur 3 detik dimulai, lalu putar sejauh yang nyaman."
          }
        }
      }
    },
