    {
      "key": "opposition.right.calibration.complete",
      "argument": null,
      "text": "Oke kita sudah tahu titik awal gerakannya. Sekarang, kita siap mulai latihan.",
      "name": "narration-id-opposition.right.calibration.complete"
    },
    {
      "key": "opposition.right.calibration.open",
      "argument": null,
      "text": "Buka kembali tangannya. Tahan lagi sebentar.",
