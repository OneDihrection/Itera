    },
    "armRaise.left.calibration.position" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We will start with your left arm. Keep your right arm beside your body."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lengan kanan tetap di samping badan."
          }
        }
      }
    },
