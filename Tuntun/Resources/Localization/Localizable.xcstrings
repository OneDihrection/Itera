    "session.assistance.sitToStand" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sit sideways to the camera with your body in view from head to knees. Move at your own pace: lean forward a little, stand up, then sit back down without dropping. Use Recalibrate if you moved the chair or camera."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Duduk menyamping ke kamera dengan tubuh terlihat dari kepala sampai lutut. Bergeraklah sesuai kemampuan: condong sedikit ke depan, berdiri, lalu duduk kembali tanpa menjatuhkan diri. Gunakan Kalibrasi ulang jika kursi atau kamera bergeser."
          }
        }
      }
