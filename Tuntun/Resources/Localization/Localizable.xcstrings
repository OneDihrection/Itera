    "opposition.left.rest.inhale.1" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Breathe in slowly through your nose…"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tarik napas pelan lewat hidung…"
          }
