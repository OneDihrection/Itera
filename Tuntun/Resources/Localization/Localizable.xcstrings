    },
    "opposition.left.rest.opening" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Well done, set one is complete. Before set two, let’s relax with three slow breaths. Follow as comfortably as you can."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hebat, set satu sudah selesai. Sebelum lanjut ke set dua, kita beri tubuh waktu untuk rileks sebentar ya. Kita akan mengambil tiga kali napas secara perlahan. Ikuti panduan ini senyamanmu."
          }
        }
      }
    },
    "opposition.left.summary.final" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Well done! You have completed all sets, with ten repetitions in total. Thank you for following each movement. Let’s rest before the next exercise."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usaha yang bagus! Kamu sudah menyelesaikan seluruh set, dengan total sepuluh repetisi. Terima kasih sudah berusaha mengikuti setiap gerakannya, ya. Sekarang, yuk istirahat sebentar sebelum lanjut ke latihan berikutnya."
          }
        }
      }
    },
    "opposition.left.summary.first" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Well done! You have completed the first set of five repetitions. Let’s rest before set two."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usaha yang bagus! Kamu sudah menyelesaikan set pertama, dengan total lima repetisi. Sekarang, yuk istirahat sebentar sebelum lanjut ke set kedua."
          }
        }
      }
    },
