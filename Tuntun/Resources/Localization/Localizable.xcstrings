        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lower your arm again and hold briefly."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Turunkan kembali lengan kiri. Tahan sebentar."
          }
        }
      }
    },
    "armRaise.left.calibration.start" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
