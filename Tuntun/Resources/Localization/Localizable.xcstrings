    "opposition.left.intro.focus" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This exercise practices pinching small objects, such as fastening a button or holding a spoon."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Latihan ini akan berfokus untuk melatih jari tangan menjepit benda kecil, seperti mengancingkan baju atau memegang sendok."
          }
        }
      }
    },
    "opposition.left.intro.goals" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This exercise has two sets of five repetitions."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Latihan ini terdiri dari dua set, dengan masing-masing set sebanyak lima repetisi."
