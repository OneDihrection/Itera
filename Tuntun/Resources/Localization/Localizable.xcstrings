    "armRaise.left.intro.focus" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Next, we will practice raising the arm. Helps the shoulder lift the arm higher, such as when reaching a shelf or combing hair."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selanjutnya, kita akan latihan Angkat Lengan yang akan berfokus pada membantu bahu mengangkat lengan lebih tinggi, seperti saat meraih rak atau menyisir rambut."
          }
        }
      }
    },
    "armRaise.left.intro.goals" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This exercise has two sets of five repetitions."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Latihan ini terdiri dari dua set, dengan masing-masing set sebanyak lima repetisi."
          }
        }
      }
    },
