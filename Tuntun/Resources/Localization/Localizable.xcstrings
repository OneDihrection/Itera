    "opposition.left.intro.voice" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If you feel uncomfortable, you can use voice commands. Say 'Stop' to pause and 'Go' to continue."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jika kamu merasa tidak nyaman selama latihan, kamu bisa menggunakan perintah suara. Katakan 'Stop' untuk berhenti sejenak, dan 'Go' untuk melanjutkan latihan."
          }
        }
      }
    },
