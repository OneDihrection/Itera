    "sitToStand.overview" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lean slightly forward, stand as far as you can, then sit back down slowly. Tuntun counts a repetition when you lean before standing."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Condongkan badan sedikit ke depan, lalu berdiri sesuai kemampuan Anda dan duduk kembali perlahan. Tuntun menghitung repetisi saat Anda condong dulu sebelum berdiri."
          }
        }
      }
    },
