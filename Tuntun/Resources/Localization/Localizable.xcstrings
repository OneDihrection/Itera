    "settings.planExercisesHelp" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Applies from the next session. Each exercise has its own side, sets, repetitions and rest. Both sides alternate after every repetition; finger exercises run once for each hand. Counts other than the recorded two sets of five change what the Indonesian scripts say."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Berlaku mulai sesi berikutnya. Tiap latihan punya sisi, set, repetisi, dan istirahatnya sendiri. Kedua sisi bergantian setiap repetisi; latihan jari dilakukan sekali untuk tiap tangan. Jumlah selain dua set lima repetisi yang direkam mengubah narasi naskah bahasa Indonesia."
          }
        }
      }
    },
