    "armRaise.left.calibration.complete" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We now know your starting movement. We are ready to begin."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kalibrasi selesai. Kita siap mulai latihan."
          }
        }
