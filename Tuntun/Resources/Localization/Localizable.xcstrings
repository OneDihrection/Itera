          }
        }
      }
    },
    "speak.armRaise.left.rest.opening" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Well done! Set one is complete. Let’s relax before set two with three comfortable, slow breaths."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hebat, set satu sudah selesai. Sebelum lanjut ke set dua, kita beri tubuh waktu untuk rileks sebentar ya. Kita akan mengambil tiga kali napas secara perlahan. Ikuti panduan ini senyamanmu."
          }
        }
      }
    },
    "speak.armRaise.left.summary.final" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Well done! You completed both sets, ten repetitions in total. Thank you for following every movement. Let’s rest before the next exercise."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usaha yang bagus! Kamu sudah menyelesaikan seluruh set, dengan total sepuluh repetisi. Terima kasih sudah berusaha mengikuti setiap gerakannya, ya. Sekarang, yuk istirahat sebentar sebelum lanjut ke latihan berikutnya."
          }
        }
      }
    },
    "speak.armRaise.left.summary.first" : {
      "extractionState" : "manual",
      "localizations" : {
