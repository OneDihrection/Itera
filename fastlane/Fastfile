# Fastfile — Created by dimaswisodewo on 03/11/2026.
default_platform(:ios)

platform :ios do
  desc "Archive a production version tag and upload to TestFlight"
  lane :beta do
    tag = ENV.fetch("RELEASE_TAG")
    UI.user_error!("Expected vMAJOR.MINOR.PATCH") unless tag.match?(/\Av\d+\.\d+\.\d+\z/)
    version = tag.delete_prefix("v")
    identifier = ENV.fetch("APP_IDENTIFIER")
    team = ENV.fetch("APPLE_TEAM_ID")

    setup_ci if ENV["CI"]
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_content: ENV.fetch("ASC_KEY_BASE64"),
      is_key_content_base64: true
    )
    match(
      type: "appstore",
      readonly: true,
      app_identifier: identifier,
      team_id: team,
      git_url: ENV.fetch("MATCH_GIT_URL"),
      api_key: api_key
    )
    number = latest_testflight_build_number(
      api_key: api_key,
      app_identifier: identifier,
      version: version,
      initial_build_number: 0
    ) + 1

    build_app(
      project: "Itera.xcodeproj",
      scheme: "Itera",
      configuration: "Release",
      destination: "generic/platform=iOS",
      export_method: "app-store",
      xcargs: "MARKETING_VERSION=#{version} CURRENT_PROJECT_VERSION=#{number} CODE_SIGN_STYLE=Manual DEVELOPMENT_TEAM=#{team} PRODUCT_BUNDLE_IDENTIFIER=#{identifier} PROVISIONING_PROFILE_SPECIFIER='match AppStore #{identifier}' CODE_SIGN_IDENTITY='Apple Distribution'",
      export_options: {
        signingStyle: "manual",
        teamID: team,
        provisioningProfiles: { identifier => "match AppStore #{identifier}" }
      }
    )
    upload_to_testflight(
      api_key: api_key,
      app_identifier: identifier,
      skip_submission: true,
      skip_waiting_for_build_processing: true
    )
  end
end
